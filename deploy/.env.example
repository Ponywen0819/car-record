# Copy to deploy/.env on the host (chmod 600; git-ignored).
# APP_TAG is written by deploy/deploy.sh — do not add an APP_TAG line manually.

# Required: your existing Postgres. Use a host the container can reach (not localhost).
DATABASE_URL=postgres://car_record:change-me@db-host:5432/car_record

# Optional: when set, /api/* requires "Authorization: Bearer <token>".
API_TOKEN=
