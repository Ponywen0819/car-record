{
  "name": "car-record",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @car-record/web build && pnpm --filter @car-record/server build",
    "dev:web": "pnpm --filter @car-record/web dev",
    "dev:server": "pnpm --filter @car-record/server dev",
    "start": "pnpm --filter @car-record/server start"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
